index c61d04c..72a6929 100644
--- a/h3_gpu.m
+++ b/h3_gpu.m
@@ -410,6 +410,7 @@ h3_gpu *h3_gpu_create(const char *shader_source_path,
             @"h3_rms_norm_f32",
             @"h3_scale_add_f32", @"h3_layer_norm_f32",
